# The Office Add-in generator's template pins @babel/core ^8, which several
# jest-ecosystem packages (jest-snapshot's transitive deps, ts-jest's
# optional peer) still declare a <8 peer range against. ts-jest doesn't
# actually require @babel/core at runtime (it compiles via the TypeScript
# compiler), so this is a safe, deliberate override rather than a real
# incompatibility — see README.md's "Development" section.
legacy-peer-deps=true
